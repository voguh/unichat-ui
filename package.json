{
    "name": "@voguh/unichat-ui",
    "description": "Standard UI library for UniChat",
    "version": "0.1.1",
    "license": "EPL-2.0",
    "author": "Voguh <voguhofc@protonmail.com>",
    "scripts": {
        "dev": "cross-env NODE_ENV=development rspack dev",
        "build": "cross-env NODE_ENV=production rspack build && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
        "lint": "biome check .",
        "test": "rstest",
        "typecheck": "tsc --noEmit"
    },
    "files": ["dist", "LICENSE", "README.md"],
    "exports": {
        "./components/*": {
            "types": "./dist/components/*/index.d.ts",
            "import": "./dist/components/*/index.mjs"
        },
        "./utils/*": {
            "types": "./dist/utils/*.d.ts",
            "import": "./dist/utils/*.mjs"
        },
        "./styles/*": "./dist/styles/*"
    },
    "dependencies": {
        "@zag-js/accordion": "1.44.0",
        "@zag-js/checkbox": "1.44.0",
        "@zag-js/clipboard": "1.44.0",
        "@zag-js/color-picker": "1.44.0",
        "@zag-js/combobox": "1.44.0",
        "@zag-js/date-picker": "1.44.0",
        "@zag-js/dialog": "1.44.0",
        "@zag-js/file-upload": "1.44.0",
        "@zag-js/menu": "1.44.0",
        "@zag-js/number-input": "1.44.0",
        "@zag-js/pagination": "1.44.0",
        "@zag-js/password-input": "1.44.0",
        "@zag-js/popover": "1.44.0",
        "@zag-js/preact": "1.44.0",
        "@zag-js/progress": "1.44.0",
        "@zag-js/qr-code": "1.44.0",
        "@zag-js/radio-group": "1.44.0",
        "@zag-js/select": "1.44.0",
        "@zag-js/switch": "1.44.0",
        "@zag-js/tabs": "1.44.0",
        "@zag-js/tags-input": "1.44.0",
        "@zag-js/toast": "1.44.0",
        "@zag-js/tooltip": "1.44.0",
        "dompurify": "3.4.16",
        "marked": "18.0.14"
    },
    "peerDependencies": {
        "@tailwindcss/typography": "^0.5.20",
        "preact": ">=10 <11",
        "tailwindcss": "^4.3.3"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.15",
        "@rspack/cli": "2.2.8",
        "@rspack/core": "2.2.8",
        "@rspack/dev-server": "2.2.1",
        "@rstest/adapter-rspack": "0.12.3",
        "@rstest/core": "0.12.3",
        "@rstest/coverage-v8": "0.12.3",
        "@tailwindcss/postcss": "^4.3.3",
        "@tailwindcss/typography": "^0.5.20",
        "@testing-library/dom": "10.4.2",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/preact": "3.2.4",
        "@testing-library/user-event": "14.6.7",
        "@types/node": "24.19.1",
        "cross-env": "10.1.0",
        "jsdom": "30.1.1",
        "postcss": "8.5.28",
        "postcss-loader": "8.2.1",
        "preact": "10.29.8",
        "tailwindcss": "^4.3.3",
        "tsc-alias": "1.9.7",
        "typescript": "7.0.2",
        "wouter-preact": "3.13.0"
    }
}
