{
    "name": "@voguh/unichat-ui",
    "description": "Standard UI library for UniChat",
    "version": "0.2.1",
    "license": "EPL-2.0",
    "author": "Voguh <voguhofc@protonmail.com>",
    "scripts": {
        "dev": "cross-env NODE_ENV=development rspack dev",
        "build": "cross-env NODE_ENV=production rspack build && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
        "lint": "biome check .",
        "test": "rstest",
        "typecheck": "tsc --noEmit"
    },
    "files": [
        "dist",
        "LICENSE",
        "README.md"
    ],
    "exports": {
        "./components/*": {
            "types": "./dist/components/*/index.d.ts",
            "import": "./dist/components/*/index.mjs"
        },
        "./hooks/*": {
            "types": "./dist/hooks/*.d.ts",
            "import": "./dist/hooks/*.mjs"
        },
        "./styles/*": "./dist/styles/*",
        "./utils/*": {
            "types": "./dist/utils/*.d.ts",
            "import": "./dist/utils/*.mjs"
        }
    },
    "dependencies": {
        "@floating-ui/dom": "1.8.0",
        "@zag-js/color-picker": "1.46.0",
        "@zag-js/combobox": "1.46.0",
        "@zag-js/date-picker": "1.46.0",
        "@zag-js/file-upload": "1.46.0",
        "@zag-js/menu": "1.46.0",
        "@zag-js/number-input": "1.46.0",
        "@zag-js/preact": "1.46.0",
        "@zag-js/select": "1.46.0",
        "@zag-js/tags-input": "1.46.0",
        "dompurify": "3.4.17",
        "lean-qr": "2.7.4",
        "marked": "18.1.1"
    },
    "peerDependencies": {
        "@tailwindcss/typography": "^0.5.20",
        "preact": ">=10 <11",
        "tailwindcss": "^4.3.3"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.15",
        "@rspack/cli": "2.2.9",
        "@rspack/core": "2.2.9",
        "@rspack/dev-server": "2.2.1",
        "@rstest/adapter-rspack": "0.12.3",
        "@rstest/core": "0.12.3",
        "@rstest/coverage-v8": "0.12.3",
        "@tailwindcss/postcss": "^4.3.3",
        "@tailwindcss/typography": "^0.5.20",
        "@testing-library/dom": "10.4.2",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/preact": "3.2.4",
        "@testing-library/user-event": "14.6.8",
        "@types/node": "24.19.1",
        "cross-env": "10.1.0",
        "jsdom": "30.1.2",
        "postcss": "8.5.30",
        "postcss-loader": "8.2.1",
        "preact": "10.29.8",
        "tailwindcss": "^4.3.3",
        "tsc-alias": "1.9.7",
        "typescript": "7.0.2",
        "wouter-preact": "3.13.0"
    }
}
