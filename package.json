{
    "name": "@voguh/unichat-ui",
    "description": "Standard UI library for UniChat",
    "version": "0.4.1",
    "license": "EPL-2.0",
    "author": "Voguh <voguhofc@protonmail.com>",
    "scripts": {
        "dev": "pnpm --filter @voguh/unichat-ui-showcase dev",
        "build": "NODE_ENV=production rspack build && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
        "lint": "biome check .",
        "test": "rstest",
        "typecheck": "tsc --noEmit"
    },
    "files": [
        "dist",
        "LICENSE",
        "README.md"
    ],
    "sideEffects": [
        "**/*.css"
    ],
    "exports": {
        "./*": {
            "types": "./dist/*/index.d.ts",
            "import": "./dist/*/index.mjs"
        },
        "./hooks/*": {
            "types": "./dist/hooks/*.d.ts",
            "import": "./dist/hooks/*.mjs"
        },
        "./preflight.css": "./dist/preflight.css",
        "./utils/*": {
            "types": "./dist/utils/*.d.ts",
            "import": "./dist/utils/*.mjs"
        }
    },
    "dependencies": {
        "@ctrl/tinycolor": "4.2.1",
        "@floating-ui/dom": "1.8.0",
        "@headlessui/react": "2.2.10",
        "dompurify": "3.4.17",
        "lean-qr": "2.7.4",
        "marked": "18.1.1",
        "vanilla-calendar-pro": "3.4.0"
    },
    "peerDependencies": {
        "react": ">=18 <20",
        "react-dom": ">=18 <20"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.15",
        "@rspack/cli": "2.2.9",
        "@rspack/core": "2.2.9",
        "@rstest/adapter-rspack": "0.12.3",
        "@rstest/core": "0.12.3",
        "@rstest/coverage-v8": "0.12.3",
        "@tailwindcss/postcss": "^4.3.3",
        "@tailwindcss/typography": "^0.5.20",
        "@testing-library/dom": "10.4.2",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/preact": "3.2.4",
        "@testing-library/react": "16.3.3",
        "@testing-library/user-event": "14.6.8",
        "@types/node": "24.19.1",
        "@types/react": "18.3.31",
        "@types/react-dom": "18.3.7",
        "jsdom": "30.1.3",
        "lightningcss": "1.33.0",
        "postcss": "8.5.30",
        "postcss-loader": "8.2.1",
        "preact": "10.29.8",
        "react": "18.3.1",
        "react-dom": "18.3.1",
        "tailwindcss": "^4.3.3",
        "tsc-alias": "1.9.8",
        "typescript": "7.0.2"
    }
}
