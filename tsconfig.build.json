{
    "extends": "./tsconfig.json",
    "include": ["./src/**/*"],
    "compilerOptions": {
        "types": ["preact"],
        "noEmit": false,
        "declaration": true,
        "emitDeclarationOnly": true,
        "rootDir": "./src",
        "outDir": "./dist",
        "paths": {
            "~/*": ["./src/*"],
            "react": ["./node_modules/preact/compat/src/index.d.ts"],
            "react/jsx-runtime": ["./node_modules/preact/jsx-runtime/src/index.d.ts"],
            "react-dom": ["./node_modules/preact/compat/src/index.d.ts"],
            "react-dom/*": ["./node_modules/preact/compat/*"]
        }
    },
    "tsc-alias": {
        "fileExtensions": { "inputGlob": "d.ts", "outputCheck": ["d.ts"] }
    }
}
