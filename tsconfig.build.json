{
    "extends": "./tsconfig.json",
    "include": ["./src/**/*"],
    "compilerOptions": {
        "types": ["react", "react-dom"],
        "noEmit": false,
        "declaration": true,
        "emitDeclarationOnly": true,
        "rootDir": "./src",
        "outDir": "./dist"
    },
    "tsc-alias": {
        "fileExtensions": { "inputGlob": "d.ts", "outputCheck": ["d.ts"] }
    }
}
